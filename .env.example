# Supabase public client configuration
# Put the real values in .env.local for local development or Vercel environment variables.
# Do not commit .env.local or any real environment file.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase PostgreSQL connection used by Prisma Client at runtime.
# For Vercel/serverless, use the Supavisor transaction-pooler connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true"

# Direct Supabase PostgreSQL connection used for Prisma migrations/admin tooling.
# Never expose this as NEXT_PUBLIC_ or commit the real value.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
